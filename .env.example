# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI (Anthropic or OpenAI-compatible)
AI_API_URL=https://api.anthropic.com/v1/messages
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Trusted Shops (eTrusted)
TRUSTED_SHOPS_CLIENT_ID=
TRUSTED_SHOPS_CLIENT_SECRET=
TRUSTED_SHOPS_CHANNELS=[]

# Trustpilot (webhook mode)
TRUSTPILOT_WEBHOOK_SECRET=

# Heureka
HEUREKA_CZ_KEY=
HEUREKA_SK_KEY=
# Shop ratings page URL (no stable per-review deep link exists, so this is the
# closest thing to link to for a manual copy-paste reply)
HEUREKA_CZ_SHOP_URL=
HEUREKA_SK_SHOP_URL=

# Firmy.cz has no API — link to the shop's own Firmy.cz page for manual replies
FIRMY_CZ_SHOP_URL=

# WPJ e-shop (products, orders, product reviews aggregated from Heureka/Zbozi/Arukereso/Compari)
# Admin -> API access. Auth header is X-Access-Token, not Authorization: Bearer.
WPJ_API_URL=https://www.oveckarna.cz/admin/graphql/
WPJ_API_KEY=

# Sklik API Fenix (replaces the Zbozi API, shut down 2026-03-16)
# Created in Sklik: Nastaveni uctu -> Sprava klicu API Fenix (read scope is enough)
SKLIK_API_KEY=
# Shop/premise ID: admin.zbozi.cz -> Provozovna -> also visible in the URL as
# https://prodejce.seznam.cz/n/premiseManageScreen?premiseId=<this>
SKLIK_PREMISE_ID=

# Email (IMAP) for Zbozi.cz / Firmy.cz
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Google Business (experimental)
GOOGLE_ACCESS_TOKEN=
GOOGLE_ACCOUNT_ID=
GOOGLE_LOCATION_ID=

# Cron sync
CRON_SECRET=
